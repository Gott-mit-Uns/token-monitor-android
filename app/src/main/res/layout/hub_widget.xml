<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_light_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_brand" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_light_text" />
    <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/widget_period" android:textSize="14sp" android:textColor="@color/widget_light_secondary" />
    <TextView android:id="@+id/widget_tokens" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/widget_no_value" android:textSize="22sp" android:fontFamily="monospace"
        android:textStyle="bold" android:textColor="@color/widget_light_text" />
    <TextView android:id="@+id/widget_cost" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/widget_empty" android:textSize="14sp" android:textColor="@color/widget_light_secondary" />
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/widget_light_secondary" />
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="48dp" android:gravity="bottom|start" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:text="@string/widget_open" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_light_accent" />
</LinearLayout>
