<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_dark_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_metric_section" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
            <TextView android:id="@+id/widget_tokens" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" />
            <TextView android:id="@+id/widget_cost" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/widget_trend_change" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="10sp" />
                <TextView android:id="@+id/widget_configure" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_align_edit_short" android:textSize="10sp" android:contentDescription="@string/widget_align_edit" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_trend" android:layout_width="match_parent" android:layout_height="34dp" android:scaleType="fitXY" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_divider_1" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="4dp" android:layout_marginBottom="6dp" android:background="#28A3ADBB" />
    <LinearLayout android:id="@+id/widget_quota_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_quota_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_align_quota" android:textSize="10sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_quota_name_1" android:layout_width="84dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/widget_quota_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_quota_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_quota_name_2" android:layout_width="84dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/widget_quota_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_divider_2" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="#28A3ADBB" />
    <LinearLayout android:id="@+id/widget_bottom_sections" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="102dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_activity_section" android:layout_width="0dp" android:layout_weight="44" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="8dp">
            <TextView android:id="@+id/widget_activity_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_align_activity" android:textSize="10sp" android:textStyle="bold" />
            <ImageView android:id="@+id/widget_activity" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="60dp" android:layout_marginTop="6dp" android:scaleType="fitXY" />
            <TextView android:id="@+id/widget_activity_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:maxLines="2" />
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:background="#28A3ADBB" />
        <LinearLayout android:id="@+id/widget_breakdown_section" android:layout_width="0dp" android:layout_weight="56" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/widget_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_detail_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            <ImageView android:id="@+id/widget_bar_1" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:scaleType="fitXY" />
            <TextView android:id="@+id/widget_detail_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            <ImageView android:id="@+id/widget_bar_2" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:scaleType="fitXY" />
            <TextView android:id="@+id/widget_detail_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            <ImageView android:id="@+id/widget_bar_3" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:scaleType="fitXY" />
            <TextView android:id="@+id/widget_detail_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            <ImageView android:id="@+id/widget_bar_4" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:scaleType="fitXY" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="10sp" android:maxLines="2" />
</LinearLayout>
